@model ProyectoGestionEventos.Models.Espacio

@{
    ViewData["Title"] = "Crear Espacio";
}

<div class="mt-5">
    <h1 class="bg-success text-white text-center py-4 rounded shadow mb-4">
        <i class="fas fa-plus-circle me-2"></i>Crear Espacio
    </h1>

    <div class="card shadow">
        <div class="card-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label fw-bold">Nombre del Espacio</label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                        <div id="e-Nombre" class="small"></div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="TipoEspacio" class="form-label fw-bold">Tipo de Espacio</label>
                        <select asp-for="TipoEspacio" class="form-select" asp-items="ViewBag.TipoEspacio">
                            <option value="">-- Seleccione --</option>
                        </select>
                        <span asp-validation-for="TipoEspacio" class="text-danger"></span>
                        <div id="e-TipoEspacio" class="small"></div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Capacidad" class="form-label fw-bold">Capacidad</label>
                        <input asp-for="Capacidad" type="number" min="1" class="form-control" />
                        <span asp-validation-for="Capacidad" class="text-danger"></span>
                        <div id="e-Capacidad" class="small"></div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Ubicacion" class="form-label fw-bold">Ubicación</label>
                        <input asp-for="Ubicacion" class="form-control" />
                        <span asp-validation-for="Ubicacion" class="text-danger"></span>
                        <div id="e-Ubicacion" class="small"></div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Descripcion" class="form-label fw-bold">Descripción (Opcional)</label>
                        <textarea asp-for="Descripcion" rows="3" class="form-control"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-3 mt-4">
                    <button type="reset" onclick="limpiar()" class="btn btn-secondary">
                        <i class="fas fa-eraser me-2"></i>Limpiar
                    </button>
                    <button type="submit" onclick="validar(event)" class="btn btn-success">
                        <i class="fas fa-save me-2"></i>Crear
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="text-end mt-4">
        <a asp-action="Index" class="btn btn-dark">
            <i class="fas fa-arrow-left me-2"></i>Volver
        </a>
    </div>
</div>

<script src="~/js/helper.js"></script>
<script>
    const validar = (evt) => {
        let isValid = true;
        document.querySelectorAll('form .form-control, form .form-select').forEach(item => {
            const errorDiv = document.getElementById('e-' + item.id);
            if (!errorDiv) return;
            
            if (item.value.trim() == '' && item.id != 'Descripcion') {
                item.classList.add('is-invalid');
                errorDiv.innerHTML = '<span class="text-danger">Campo obligatorio</span>';
                isValid = false;
            } else {
                errorDiv.innerHTML = '';
                item.classList.remove('is-invalid');
                
                // Validar solo espacios
                if (item.value.trim() !== '' && !validarSoloEspacios(item.value) && item.id != 'Descripcion') {
                    item.classList.add('is-invalid');
                    errorDiv.innerHTML = '<span class="text-danger">No puede contener solo espacios</span>';
                    isValid = false;
                }
                
                if (item.id == 'Capacidad' && item.value <= 0) {
                    item.classList.add('is-invalid');
                    errorDiv.innerHTML = '<span class="text-danger">La capacidad debe ser mayor a 0</span>';
                    isValid = false;
                }
                
                if (!item.classList.contains('is-invalid')) {
                    item.classList.add('is-valid');
                }
            }
        });
        
        if (!isValid) {
            evt.preventDefault();
        }
    }
    
    // Validación en tiempo real
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('input[type="text"], textarea').forEach(input => {
            if (input.id !== 'Descripcion') {
                input.addEventListener('keydown', prevenirEspaciosInicio);
            }
        });
    });
</script>
