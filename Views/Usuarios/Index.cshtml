@model ProyectoGestionEventos.Helpers.PaginatedList<ProyectoGestionEventos.Models.Usuario>

@{
    ViewData["Title"] = "Lista de Usuarios";
}

<div class="py-4">
    <h1 class="bg-primary text-white text-center py-4 rounded shadow mb-4">
        <i class="fas fa-users me-2"></i>Lista de Usuarios
    </h1>

    <div class="d-flex justify-content-between mb-3">
        <div>
            <a asp-action="ExportarExcel" asp-route-searchString="@ViewData["CurrentFilter"]" class="btn btn-success me-2">
                <i class="fas fa-file-excel me-2"></i>Exportar a Excel
            </a>
            <a asp-action="ExportarPDF" asp-route-searchString="@ViewData["CurrentFilter"]" class="btn btn-danger">
                <i class="fas fa-file-pdf me-2"></i>Exportar a PDF
            </a>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>
                Crear Usuario
            </a>
        </div>
    </div>

    <div class="card shadow mb-3">
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="input-group">
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" 
                           class="form-control" placeholder="Buscar por nombre, apellido, email o RUN..." />
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search me-2"></i>Buscar
                    </button>
                    @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
                    {
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times me-2"></i>Limpiar
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>RUN</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Email</th>
                        <th>Teléfono</th>
                        <th>Tipo Usuario</th>
                        <th>Rol</th>
                        <th>Cargo</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Run)</td>
                            <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                            <td>@Html.DisplayFor(modelItem => item.Apellido)</td>
                            <td>@Html.DisplayFor(modelItem => item.Email)</td>
                            <td>@Html.DisplayFor(modelItem => item.Telefono)</td>
                            <td>
                                <span class="badge bg-info">
                                    @Html.DisplayFor(modelItem => item.TipoUsuario)
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-success">
									@Html.DisplayFor(modelItem => item.IdRolNavigation!.Rol1)
                                </span>
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.Cargo)</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-warning me-1">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <button class="btn btn-sm btn-danger" onclick="eliminar(this.id)" id="@item.IdUsuario">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @{
        var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
        var nextDisabled = !Model.HasNextPage ? "disabled" : "";
    }
    <div class="mt-3 d-flex justify-content-between align-items-center">
        <div>
            Mostrando página @Model.PageIndex de @Model.TotalPages
        </div>
        <div>
            <a asp-action="Index" 
               asp-route-pageNumber="@(Model.PageIndex - 1)"
               asp-route-searchString="@ViewData["CurrentFilter"]"
               class="btn btn-primary @prevDisabled">
                <i class="fas fa-chevron-left"></i> Anterior
            </a>
            <a asp-action="Index" 
               asp-route-pageNumber="@(Model.PageIndex + 1)"
               asp-route-searchString="@ViewData["CurrentFilter"]"
               class="btn btn-primary @nextDisabled">
                Siguiente <i class="fas fa-chevron-right"></i>
            </a>
        </div>
    </div>
</div>

<script>
    const eliminar = (id) => {
        Swal.fire({
            title: "¿Estás seguro de eliminar el usuario?",
            text: "No podrás revertir los cambios",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Eliminar",
            cancelButtonText: "Cancelar"
        }).then((result) => {
            if (result.isConfirmed) {
                fetch('@Url.Action("Delete", "Usuarios")/' + id)
                    .then(response => response.json())
                    .then(data => {
                        if (data == 'ok') {
                            Swal.fire({
                                title: "Usuario eliminado con éxito",
                                text: "",
                                icon: "success"
                            }).then((result) => {
                                location.reload()
                            })
                        }
                    })
            }
        });
    }
</script>
