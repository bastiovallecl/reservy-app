@model ProyectoGestionEventos.Models.Recurso

@{
 ViewData["Title"] = "Editar Recurso";
}

<div class="mt-5">
 <h1 class="bg-warning text-white text-center py-4 rounded shadow mb-4">
 <i class="fas fa-edit me-2"></i>Editar Recurso: @Model.Nombre
 </h1>

 <div class="card shadow">
 <div class="card-body">
 <form asp-action="Edit">
 <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
 <input type="hidden" asp-for="IdRecurso" />
 <input type="hidden" asp-for="Estado" />
 <input type="hidden" asp-for="FechaRegistro" />
 
 <div class="row g-3">
 <div class="col-md-6">
 <label asp-for="Nombre" class="form-label fw-bold">Nombre del Recurso</label>
 <input asp-for="Nombre" class="form-control" />
 <span asp-validation-for="Nombre" class="text-danger"></span>
 <div id="e-Nombre" class="small"></div>
 </div>

 <div class="col-md-6">
 <label asp-for="TipoRecurso" class="form-label fw-bold">Tipo de Recurso</label>
 <select asp-for="TipoRecurso" class="form-select" asp-items="ViewBag.TipoRecurso">
 <option value="">-- Seleccione --</option>
 </select>
 <span asp-validation-for="TipoRecurso" class="text-danger"></span>
 <div id="e-TipoRecurso" class="small"></div>
 </div>

 <div class="col-md-6">
 <label asp-for="CantidadDisponible" class="form-label fw-bold">Cantidad Disponible</label>
 <input asp-for="CantidadDisponible" type="number" min="0" class="form-control" />
 <span asp-validation-for="CantidadDisponible" class="text-danger"></span>
 <div id="e-CantidadDisponible" class="small"></div>
 </div>

 <div class="col-12">
 <label asp-for="Descripcion" class="form-label fw-bold">Descripción (Opcional)</label>
 <textarea asp-for="Descripcion" rows="3" class="form-control"></textarea>
 <span asp-validation-for="Descripcion" class="text-danger"></span>
 </div>
 </div>

 <div class="d-flex justify-content-center gap-3 mt-4">
 <button type="reset" class="btn btn-secondary">
 <i class="fas fa-undo me-2"></i>Restablecer
 </button>
 <button type="submit" onclick="validar(event)" class="btn btn-success">
 <i class="fas fa-save me-2"></i>Guardar
 </button>
 </div>
 </form>
 </div>
 </div>

 <div class="text-end mt-4">
 <a asp-action="Index" class="btn btn-dark">
 <i class="fas fa-arrow-left me-2"></i>Volver
 </a>
 </div>
</div>

<script src="~/js/helper.js"></script>
<script>
 const validar = (evt) => {
 let isValid = true;
 document.querySelectorAll('form input:not([type="hidden"]), form select, form textarea').forEach(item => {
 const errorDiv = document.getElementById('e-' + item.id);
 if (!errorDiv) return;
 
 if (item.value.trim() == '' && item.id != 'Descripcion') {
 item.classList.add('is-invalid');
 errorDiv.innerHTML = '<span class="text-danger">Campo obligatorio</span>';
 isValid = false;
 } else {
 errorDiv.innerHTML = '';
 item.classList.remove('is-invalid');
 
 if (item.id == 'CantidadDisponible' && item.value < 0) {
 item.classList.add('is-invalid');
 errorDiv.innerHTML = '<span class="text-danger">La cantidad debe ser mayor o igual a 0</span>';
 isValid = false;
 }
 
 if (!item.classList.contains('is-invalid')) {
 item.classList.add('is-valid');
 }
 }
 });
 
 if (!isValid) {
 evt.preventDefault();
 }
 }
</script>

@section Scripts {
 @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
