@model ProyectoGestionEventos.Helpers.PaginatedList<ProyectoGestionEventos.Models.Recurso>

@{
 ViewData["Title"] = "Lista de Recursos";
}

<div class="py-4">
 <h1 class="bg-warning text-white text-center py-4 rounded shadow mb-4">
 <i class="fas fa-box me-2"></i>Lista de Recursos
 </h1>

 <div class="d-flex justify-content-between mb-3">
 <div>
 <a asp-action="ExportarExcel" asp-route-searchString="@ViewData["CurrentFilter"]" class="btn btn-success me-2">
 <i class="fas fa-file-excel me-2"></i>Exportar a Excel
 </a>
 <a asp-action="ExportarPDF" asp-route-searchString="@ViewData["CurrentFilter"]" class="btn btn-danger">
 <i class="fas fa-file-pdf me-2"></i>Exportar a PDF
 </a>
 </div>
 <div>
 <a asp-action="Create" class="btn btn-warning text-white">
 <i class="fas fa-plus me-2"></i>
 Crear Recurso
 </a>
 </div>
 </div>

 <div class="card shadow mb-3">
 <div class="card-body">
 <form asp-action="Index" method="get">
 <div class="input-group">
 <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" 
 class="form-control" placeholder="Buscar por nombre o tipo..." />
 <button type="submit" class="btn btn-warning text-white">
 <i class="fas fa-search me-2"></i>Buscar
 </button>
 @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
 {
 <a asp-action="Index" class="btn btn-secondary">
 <i class="fas fa-times me-2"></i>Limpiar
 </a>
 }
 </div>
 </form>
 </div>
 </div>

 <div class="card shadow">
 <div class="table-responsive">
 <table class="table table-striped table-hover mb-0">
 <thead class="table-dark">
 <tr>
 <th>Nombre</th>
 <th>Tipo</th>
 <th>Descripción</th>
 <th>Cantidad Disponible</th>
 <th class="text-center">Acciones</th>
 </tr>
 </thead>
 <tbody>
 @foreach (var item in Model)
 {
 <tr>
 <td class="fw-bold">@Html.DisplayFor(modelItem => item.Nombre)</td>
 <td>
 <span class="badge bg-warning text-dark">
 @Html.DisplayFor(modelItem => item.TipoRecurso)
 </span>
 </td>
 <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
 <td>
 <span class="badge bg-info">
 @Html.DisplayFor(modelItem => item.CantidadDisponible) unidades
 </span>
 </td>
 <td class="text-center">
 <a asp-action="Edit" asp-route-id="@item.IdRecurso" class="btn btn-sm btn-warning me-1">
 <i class="fa-solid fa-pen-to-square"></i>
 </a>
 <button class="btn btn-sm btn-danger" onclick="eliminar(this.id)" id="@item.IdRecurso">
 <i class="fa-solid fa-trash"></i>
 </button>
 </td>
 </tr>
 }
 </tbody>
 </table>
 </div>
 </div>

 @{
 var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
 var nextDisabled = !Model.HasNextPage ? "disabled" : "";
 }
 <div class="mt-3 d-flex justify-content-between align-items-center">
 <div>
 Mostrando página @Model.PageIndex de @Model.TotalPages
 </div>
 <div>
 <a asp-action="Index" 
 asp-route-pageNumber="@(Model.PageIndex - 1)"
 asp-route-searchString="@ViewData["CurrentFilter"]"
 class="btn btn-warning text-white @prevDisabled">
 <i class="fas fa-chevron-left"></i> Anterior
 </a>
 <a asp-action="Index" 
 asp-route-pageNumber="@(Model.PageIndex + 1)"
 asp-route-searchString="@ViewData["CurrentFilter"]"
 class="btn btn-warning text-white @nextDisabled">
 Siguiente <i class="fas fa-chevron-right"></i>
 </a>
 </div>
 </div>
</div>

<script>
 const eliminar = (id) => {
 Swal.fire({
 title: "¿Estás seguro de eliminar el recurso?",
 text: "No podrás revertir los cambios",
 icon: "warning",
 showCancelButton: true,
 confirmButtonColor: "#d33",
 cancelButtonColor: "#3085d6",
 confirmButtonText: "Eliminar",
 cancelButtonText: "Cancelar"
 }).then((result) => {
 if (result.isConfirmed) {
 fetch('@Url.Action("Delete", "Recursos")/' + id)
 .then(response => response.json())
 .then(data => {
 if (data == 'ok') {
 Swal.fire({
 title: "Recurso eliminado con éxito",
 text: "",
 icon: "success"
 }).then((result) => {
 location.reload()
 })
 }
 })
 }
 });
 }
</script>
