@model ProyectoGestionEventos.Helpers.PaginatedList<ProyectoGestionEventos.Models.Reserva>

@{
 ViewData["Title"] = "Lista de Reservas";
}

<div class="py-4">
 <h1 class="bg-info text-white text-center py-4 rounded shadow mb-4">
 <i class="fas fa-clipboard-list me-2"></i>Lista de Reservas
 </h1>

 <div class="d-flex justify-content-between mb-3">
 <div>
 <a asp-action="ExportarExcel" asp-route-searchString="@ViewData["CurrentFilter"]" class="btn btn-success me-2">
 <i class="fas fa-file-excel me-2"></i>Exportar a Excel
 </a>
 <a asp-action="ExportarPDF" asp-route-searchString="@ViewData["CurrentFilter"]" class="btn btn-danger">
 <i class="fas fa-file-pdf me-2"></i>Exportar a PDF
 </a>
 </div>
 <div>
 <a asp-action="Create" class="btn btn-info text-white">
 <i class="fas fa-plus me-2"></i>
 Crear Reserva
 </a>
 </div>
 </div>

 <div class="card shadow mb-3">
 <div class="card-body">
 <form asp-action="Index" method="get">
 <div class="input-group">
 <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" 
 class="form-control" placeholder="Buscar por espacio, usuario, evento o estado..." />
 <button type="submit" class="btn btn-info text-white">
 <i class="fas fa-search me-2"></i>Buscar
 </button>
 @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
 {
 <a asp-action="Index" class="btn btn-secondary">
 <i class="fas fa-times me-2"></i>Limpiar
 </a>
 }
 </div>
 </form>
 </div>
 </div>

 <div class="card shadow">
 <div class="table-responsive">
 <table class="table table-striped table-hover mb-0">
 <thead class="table-dark">
 <tr>
 <th>ID</th>
 <th>Espacio</th>
 <th>Usuario</th>
 <th>Evento</th>
 <th>Fecha Inicio</th>
 <th>Fecha Fin</th>
 <th>Asistentes</th>
 <th>Estado</th>
 <th class="text-center">Acciones</th>
 </tr>
 </thead>
 <tbody>
 @foreach (var item in Model)
 {
 <tr>
 <td class="fw-bold">#@Html.DisplayFor(modelItem => item.IdReserva)</td>
 <td>@Html.DisplayFor(modelItem => item.IdEspacioNavigation.Nombre)</td>
 <td>@Html.DisplayFor(modelItem => item.IdUsuarioNavigation.Nombre) @Html.DisplayFor(modelItem => item.IdUsuarioNavigation.Apellido)</td>
 <td>@Html.DisplayFor(modelItem => item.IdEventoNavigation.Titulo)</td>
 <td>@item.FechaInicio.ToString("dd/MM/yyyy HH:mm")</td>
 <td>@item.FechaFin.ToString("dd/MM/yyyy HH:mm")</td>
 <td class="text-center">@Html.DisplayFor(modelItem => item.CantidadAsistentes)</td>
 <td>
 @if (item.EstadoReserva == "Pendiente")
 {
 <span class="badge bg-warning text-dark">
 @Html.DisplayFor(modelItem => item.EstadoReserva)
 </span>
 }
 else if (item.EstadoReserva == "Aprobada")
 {
 <span class="badge bg-success">
 @Html.DisplayFor(modelItem => item.EstadoReserva)
 </span>
 }
 else if (item.EstadoReserva == "Rechazada")
 {
 <span class="badge bg-danger">
 @Html.DisplayFor(modelItem => item.EstadoReserva)
 </span>
 }
 </td>
 <td class="text-center">
 <a asp-action="Edit" asp-route-id="@item.IdReserva" class="btn btn-sm btn-warning me-1">
 <i class="fa-solid fa-pen-to-square"></i>
 </a>
 <button class="btn btn-sm btn-danger" onclick="eliminar(this.id)" id="@item.IdReserva">
 <i class="fa-solid fa-trash"></i>
 </button>
 </td>
 </tr>
 }
 </tbody>
 </table>
 </div>
 </div>

 @{
 var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
 var nextDisabled = !Model.HasNextPage ? "disabled" : "";
 }
 <div class="mt-3 d-flex justify-content-between align-items-center">
 <div>
 Mostrando página @Model.PageIndex de @Model.TotalPages
 </div>
 <div>
 <a asp-action="Index" 
 asp-route-pageNumber="@(Model.PageIndex - 1)"
 asp-route-searchString="@ViewData["CurrentFilter"]"
 class="btn btn-info text-white @prevDisabled">
 <i class="fas fa-chevron-left"></i> Anterior
 </a>
 <a asp-action="Index" 
 asp-route-pageNumber="@(Model.PageIndex + 1)"
 asp-route-searchString="@ViewData["CurrentFilter"]"
 class="btn btn-info text-white @nextDisabled">
 Siguiente <i class="fas fa-chevron-right"></i>
 </a>
 </div>
 </div>
</div>

<script>
 const eliminar = (id) => {
 Swal.fire({
 title: "¿Estás seguro de cancelar la reserva?",
 text: "No podrás revertir los cambios",
 icon: "warning",
 showCancelButton: true,
 confirmButtonColor: "#d33",
 cancelButtonColor: "#3085d6",
 confirmButtonText: "Cancelar Reserva",
 cancelButtonText: "No"
 }).then((result) => {
 if (result.isConfirmed) {
 fetch('@Url.Action("Delete", "Reservas")/' + id)
 .then(response => response.json())
 .then(data => {
 if (data == 'ok') {
 Swal.fire({
 title: "Reserva cancelada con éxito",
 text: "",
 icon: "success"
 }).then((result) => {
 location.reload()
 })
 }
 })
 }
 });
 }
</script>
